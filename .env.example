# Telegram
BOT_TOKEN=123456:telegram_bot_token
ADMIN_CHAT_ID=123456789

# Apps Script Web App
SHEETS_WEBAPP_URL=https://script.google.com/macros/s/XXXX/exec
SHEETS_API_SECRET=CHANGE_ME_SECRET

# Test
TEST_MODE=true
ALLOW_TEST_COMMANDS=true
WARMUP_FAST_DELAY_MS=1200

# Automation (warmup scheduler)
# AUTOMATION_ENABLED=false — cron runs but does nothing until set to true
AUTOMATION_ENABLED=false
# AUTOMATION_ALLOWED_IDS — comma-separated Telegram IDs to process; empty = all active leads
AUTOMATION_ALLOWED_IDS=
# INTERNAL_TELEGRAM_IDS — test accounts, shown as [internal] in dry-run reports
INTERNAL_TELEGRAM_IDS=274328371,289634658
# MAX_AUTOMATION_SENDS_PER_TICK — safety limit per hourly tick
MAX_AUTOMATION_SENDS_PER_TICK=5
